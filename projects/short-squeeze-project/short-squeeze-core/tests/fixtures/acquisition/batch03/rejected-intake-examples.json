{"document":"phase_3d_batch_03_rejected_intake_examples","examples":[{"bundle_reason_codes":["ARTIFACT_SHA256_MISMATCH"],"description":"Manifest SHA-256 does not match the raw bytes (tamper).","normalization_status":"REJECTED","scenario":"artifact_sha256_mismatch"},{"bundle_reason_codes":["ARTIFACT_BYTE_LENGTH_MISMATCH"],"description":"Manifest byte length does not match the raw bytes (tamper).","normalization_status":"REJECTED","scenario":"artifact_byte_length_mismatch"},{"bundle_reason_codes":["INVALID_OHLC_RELATIONSHIP"],"description":"A bar high is below open/close (impossible OHLC).","normalization_status":"REJECTED","scenario":"invalid_ohlc_relationship"},{"bundle_reason_codes":["NEGATIVE_VOLUME"],"description":"A bar carries negative volume.","normalization_status":"REJECTED","scenario":"negative_volume"},{"bundle_reason_codes":["MALFORMED_DECIMAL"],"description":"A price is not a valid decimal.","normalization_status":"REJECTED","scenario":"malformed_decimal"},{"bundle_reason_codes":["NAN_OR_INFINITY"],"description":"A price is NaN.","normalization_status":"REJECTED","scenario":"non_finite_value"},{"bundle_reason_codes":["MISSING_OHLC_VALUE"],"description":"A required OHLC value is missing and is never inferred.","normalization_status":"REJECTED","scenario":"missing_ohlc_value"},{"bundle_reason_codes":["EVENT_TIME_OUTSIDE_COVERAGE"],"description":"A bar falls outside the manifest's declared coverage window.","normalization_status":"REJECTED","scenario":"event_time_outside_coverage"},{"bundle_reason_codes":["SYMBOL_MISMATCH"],"description":"A row symbol disagrees with the manifest's declared symbol.","normalization_status":"REJECTED","scenario":"symbol_mismatch"},{"bundle_reason_codes":["CONFLICTING_DUPLICATE_BAR"],"description":"Two rows share a timestamp but disagree on values.","normalization_status":"REJECTED","scenario":"conflicting_duplicate_bar"},{"bundle_reason_codes":["OVERLAPPING_BARS"],"description":"A later bar starts before the previous bar's end