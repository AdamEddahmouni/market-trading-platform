# Short Squeeze Research Screener — environment template (placeholders only)
# Copy to `.env` (gitignored) or set the same names in your process / platform secrets.
# Never commit real credentials. Frozen demo needs no provider keys.
#
# Precedence: CLI > process environment > --config file > LOCAL_FULL private file > defaults
# Full reference: docs/CONFIGURATION.md  |  Security locks: docs/SECURITY.md

# ── Runtime ───────────────────────────────────────────────────────────
SQUEEZE_APP_MODE=replace_with_your_deployment_mode
# LOCAL_FULL | CLOUD_PROVIDER_MODE | FROZEN_DEMO
PORT=replace_with_your_port
# Native default 8787. Docker Compose sets PORT=8080 inside the container (host maps 8787→8080).
LOG_LEVEL=replace_with_your_log_level

# ── Opt-in API hardening (default off; keep public demos usable) ──────
# Set to true/1 only after clients can send CSRF cookie + X-CSRF-Token.
CSRF_PROTECTION=replace_with_your_csrf_protection_flag
LOCK_SENSITIVE_API=replace_with_your_lock_sensitive_api_flag

# ── Finviz Elite ──────────────────────────────────────────────────────
FINVIZ_ENABLED=replace_with_your_finviz_enabled_flag
FINVIZ_API_KEY=replace_with_your_finviz_api_key

# ── NewsAPI ───────────────────────────────────────────────────────────
NEWSAPI_ENABLED=replace_with_your_newsapi_enabled_flag
NEWSAPI_KEY=replace_with_your_newsapi_key

# ── Finnhub ───────────────────────────────────────────────────────────
FINNHUB_ENABLED=replace_with_your_finnhub_enabled_flag
FINNHUB_KEY=replace_with_your_finnhub_key

# ── SEC EDGAR ─────────────────────────────────────────────────────────
SEC_ENABLED=replace_with_your_sec_enabled_flag
SEC_USER_AGENT=replace_with_your_org_name/1.0 contact@example.invalid
SEC_CONTACT_EMAIL=replace_with_your_sec_contact_email@example.invalid

# ── IBKR (market data; LOCAL_FULL or remote gateway) ──────────────────
IBKR_ENABLED=replace_with_your_ibkr_enabled_flag
IBKR_HOST=replace_with_your_ibkr_host
IBKR_PORT=replace_with_your_ibkr_port
IBKR_CLIENT_ID=replace_with_your_ibkr_client_id
# Login for Docker/Railway ib-gateway sidecar (mapped to TWS_USERID / TWS_PASSWORD)
IBKR_USER_ID=replace_with_your_ibkr_username
IBKR_PASSWORD=replace_with_your_ibkr_password
IBKR_TRADE_MODE=replace_with_your_ibkr_trade_mode
# paper | live

# ── Local sentiment (FinBERT; not required for frozen/cloud demos) ────
SENTIMENT_ENABLED=replace_with_your_sentiment_enabled_flag
SENTIMENT_PROVIDER=replace_with_your_sentiment_provider
# local_finbert (default) or keyword
SENTIMENT_MODEL_PATH=replace_with_your_sentiment_model_path
# Optional checkpoint directory; empty → search models/finbert_finetuned then ProsusAI/finbert
SENTIMENT_BATCH_SIZE=replace_with_your_sentiment_batch_size

# ── News orchestration ────────────────────────────────────────────────
NEWS_PROVIDER_ORDER=replace_with_your_news_provider_order
NEWS_CACHE_TTL_SECONDS=replace_with_your_news_cache_ttl_seconds
NEWS_MAX_HEADLINES_PER_SYMBOL=replace_with_your_news_max_headlines_per_symbol

# ── Refresh / freshness / charts ──────────────────────────────────────
QUOTE_REFRESH_SECONDS=replace_with_your_quote_refresh_seconds
SCANNER_REFRESH_SECONDS=replace_with_your_scanner_refresh_seconds
FRESHNESS_CURRENT_SECONDS=replace_with_your_freshness_current_seconds
FRESHNESS_DELAYED_SECONDS=replace_with_your_freshness_delayed_seconds
MAX_CHART_POINTS=replace_with_your_max_chart_points

# ── Collectors (optional; see docs/COLLECTORS.md) ─────────────────────
# Uncomment and set when needed. Defaults live in apps/research_screener/config.py.
# COLLECTORS_ENABLED=true
# COLLECTOR_TICK_SECONDS=30
# YFINANCE_COLLECTOR_ENABLED=false
# POLYGON_COLLECTOR_ENABLED=false
# ALPHA_VANTAGE_COLLECTOR_ENABLED=false
