{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui1.opportunity_summary",
  "title": "OpportunitiesSummary",
  "type": "object",
  "required": ["as_of_context", "quality_summary", "feed_status", "items"],
  "properties": {
    "as_of_context": { "type": "object" },
    "quality_summary": { "type": "object" },
    "feed_status": { "type": "string" },
    "reason": { "type": "string" },
    "unready_reason": { "type": "string" },
    "next_action": { "type": "string" },
    "next_cursor": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary_id", "headline"],
        "properties": {
          "summary_id": { "type": "string" },
          "headline": { "type": "string" },
          "instrument_id": { "type": ["string", "null"] },
          "opportunity_id": { "type": ["string", "null"] },
          "identity_kind": { "type": "string" },
          "eligibility_state": { "type": ["string", "null"] },
          "lifecycle_state": { "type": ["string", "null"] },
          "next_safe_action": { "type": "string" },
          "rank_order": { "type": ["integer", "null"] },
          "ranking_vector": { "type": ["object", "null"] },
          "data_quality": { "type": ["object", "null"] },
          "unavailable_fields": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true,
        "not": {
          "anyOf": [
            { "required": ["rank_score"] },
            { "required": ["universal_score"] },
            { "required": ["opaque_score"] }
          ]
        }
      }
    }
  },
  "additionalProperties": true
}
