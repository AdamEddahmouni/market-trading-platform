{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui1.opportunity_summary",
  "title": "OpportunitySummary",
  "type": "object",
  "required": ["summary_id", "headline"],
  "properties": {
    "schema_version": { "type": "string" },
    "summary_id": { "type": "string" },
    "instrument_id": { "type": ["string", "null"] },
    "headline": { "type": "string" },
    "catalyst_ids": { "type": "array", "items": { "type": "string" } },
    "source_event_id": { "type": "string" },
    "campaign_slug": { "type": ["string", "null"] },
    "accepted": { "type": "boolean" },
    "rank_order": { "type": ["integer", "null"] },
    "opportunity_id": { "type": ["string", "null"] },
    "strategy_family": { "type": ["string", "null"] },
    "strategy_version": { "type": ["string", "null"] },
    "side": { "type": ["string", "null"] },
    "horizon_ns": { "type": ["integer", "null"], "description": "Epoch nanoseconds" },
    "valid_until_ns": { "type": ["integer", "null"], "description": "Epoch nanoseconds" },
    "mechanism": { "type": ["string", "null"] },
    "evidence_class": { "type": ["string", "null"] },
    "eligibility_state": { "type": ["string", "null"] },
    "data_quality": { "type": ["object", "null"] },
    "ranking_vector": {
      "type": ["object", "null"],
      "required": ["basis", "dimensions"],
      "properties": {
        "basis": { "type": "string" },
        "rank_order": { "type": ["integer", "null"] },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" },
              "value": true,
              "unit": { "type": ["string", "null"] },
              "reason_code": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "lifecycle_state": { "type": ["string", "null"] },
    "lineage_refs": { "type": "array" },
    "account_id": { "type": ["string", "null"] },
    "mode": { "type": ["string", "null"] },
    "next_safe_action": { "type": "string" },
    "unavailable_fields": { "type": "array", "items": { "type": "string" } },
    "duplicates": { "type": "array", "items": { "type": "string" } },
    "identity_kind": { "type": "string" },
    "explanation_ref": { "type": "string" },
    "instrument_key": {
      "type": ["string", "null"],
      "description": "Not emitted on HTTP ranked summary; secret-shaped name (key). Use instrument_id."
    },
    "created_at_ns": { "type": ["integer", "null"], "description": "Persist OpportunityV1.created_at_ns projected at HTTP read time; not review-row metadata" },
    "expected_return": { "type": ["number", "null"] },
    "expected_net_edge": { "type": ["number", "null"] },
    "evidence_promotion_reason": { "type": ["string", "null"] },
    "family_admission_status": { "type": ["string", "null"] },
    "family_admission_reason": { "type": ["string", "null"] },
    "family_admission_kind": { "type": ["string", "null"] },
    "supersession_reason": { "type": ["string", "null"] },
    "duplicate_reason": { "type": ["string", "null"] },
    "decision_support": {
      "type": "object",
      "properties": {
        "authority": {
          "type": "string",
          "description": "Not emitted on HTTP ranked summary; secret-shaped name (auth)."
        },
        "kill_switch": { "type": "string" },
        "gross_exposure": { "type": "object" },
        "concentration": { "type": "object" },
        "risk_decision": { "type": "object" },
        "reason_codes": { "type": "array", "items": { "type": "string" } }
      },
      "not": { "required": ["order_id"] }
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true,
  "not": {
    "anyOf": [
      { "required": ["rank_score"] },
      { "required": ["universal_score"] },
      { "required": ["opaque_score"] }
    ]
  }
}
