# Assistant inference (optional — copy to your shell or a local .env file; never commit secrets)
ANTHROPIC_API_KEY=CHANGEME
ANTHROPIC_MODEL=claude-sonnet-4-20250514
IMP_ASSISTANT_PROVIDER=anthropic

# Fallback modes:
# IMP_ASSISTANT_PROVIDER=grounded
# IMP_ASSISTANT_STUB=1

# Public SEC EDGAR (no API key). Required for live/opt-in SEC access.
# Example: IntegratedMarketPlatform research contact@example.com
SEC_USER_AGENT=
# IMP_EDGAR_LIVE=1
# SEC_LIVE_TESTS=1

# FINRA Individual Public API credential (never commit real values).
# Runtime OAuth uses Client ID + Client Secret only. Gateway login is not used.
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
# Non-secret rotation metadata (ISO date). Do not infer expiry from the secret.
FINRA_SECRET_ROTATED_AT=
# Optional explicit expiry. If unset, rotated_at + 365 days is used when rotated_at is set.
FINRA_SECRET_EXPIRES_AT=
# IMP_FINRA_LIVE=1
# IMP_NASDAQ_REGSHO_LIVE=1
# IMP_NYSE_REGSHO_LIVE=1
# IMP_FINRA_OTC_THRESHOLD_LIVE=1
# IMP_CBOE_REGSHO_LIVE=1
# IMP_SEC_FTD_LIVE=1

# Federal Reserve Bank of St. Louis FRED / ALFRED (never commit real values).
FRED_API_KEY=
# IMP_FRED_LIVE=1

# U.S. Energy Information Administration Open Data API v2 (never commit real values).
EIA_API_KEY=
# IMP_EIA_LIVE=1

# NOAA/NWS/CPC weather evidence requires no API credential.
# Optional NCEI Climate Data Online token (only needed for deferred CDO validation).
# NOAA_CDO_TOKEN=
# Optional non-secret NWS application identifier override:
# IMP_NWS_USER_AGENT=integrated-market-platform-weather/1.0
# Opt-in live weather validation:
# IMP_WEATHER_LIVE=1

# Live observational market data (Platformization P2/P2.1). All default off.
# IMP_LIVE_OBSERVATIONAL=1
# IMP_MOOMOO_LIVE=1
# IMP_MOOMOO_HOST=127.0.0.1
# IMP_MOOMOO_PORT=11111
# IMP_PAPER_EXECUTION=1
# IMP_LIVE_INTERNAL_SIMULATION=1
# Optional local JSONL feed for offline/CI live-runtime testing (no OpenD needed).
# IMP_LIVE_FIXTURE_FEED=...
# IMP_LIVE_CAPTURE_ROOT=...                 # capture root override
# IMP_MOOMOO_SUBSCRIPTION_QUOTA=...         # max concurrent subscriptions
# IMP_LIVE_EXECUTION_WAIT_MS=8000           # wait for an EXECUTION_ADMITTED event
# IMP_LIVE_EXECUTION_FRESHNESS_MS=5000      # max fresh L1 age for execution
# IMP_LIVE_QUOTE_STALE_MS=5000              # quote staleness threshold
# IMP_LIVE_CLOCK_DRIFT_MS=60000             # provider clock drift tolerance
# IMP_LIVE_RECONNECT_BACKOFF_SEC=1,2,5,10,30

# Finviz Elite export API (never commit real values).
# Official export token from https://elite.finviz.com/ — also accepts FINVIZ_AUTH_TOKEN.
FINVIZ_API_KEY=
# IMP_FINVIZ_LIVE=1
# IMP_FINVIZ_CAPTURE_DIR=...                # prospective capture root
# IMP_FINVIZ_EVIDENCE_DIR=...               # evidence output override
# IMP_FINVIZ_SECRET_DIR=.private            # token/login file store
# Optional provider credential file (FINVIZ_API_KEY, etc.)
# IMP_PROVIDER_ENV=.private/providers.env

# Read-only company-news providers. Configure through tools/news/auth.py.
# NEWSAPI_API_KEY=
# FINNHUB_API_KEY=
# IMP_NEWSAPI_LIVE=1
# IMP_FINNHUB_LIVE=1

# Local durable state (P3). Override directory; never commit the DB.
# IMP_PERSIST_STATE=1
# IMP_STATE_DIR=

# Operational intelligence persistence (BUILD 04.5). Local development only.
# IMP_MONGODB_URI=mongodb://127.0.0.1:27017
# IMP_MONGODB_DATABASE=imp_intelligence
# IMP_MONGODB_SERVER_SELECTION_TIMEOUT_MS=2000
# IMP_TEST_MONGODB_URI=mongodb://127.0.0.1:27017
# IMP_TEST_MONGODB_DATABASE=imp_test_local

# External broker paper execution (Platformization P4 / sub-milestone 4A). All default off.
# The 4A adapter is fixture-first: CI runs against recorded sandbox responses; a live HTTP
# transport is NOT implemented until the wire contract is verified and recorded in
# docs/providers/TRADIER_PAPER.md. Never set any of these in CI.
# IMP_TRADIER_PAPER=1
# IMP_BROKER_PAPER_EXECUTION=1
# IMP_TRADIER_TOKEN=            # sandbox bearer token (never commit real values)
# IMP_TRADIER_ENDPOINT=https://sandbox.tradier.com/v1   # fails closed if changed
# IMP_TRADIER_ACCOUNT_ID=       # sandbox account to address
# Legacy DisabledPaperExecutionProvider gate (EXECUTION_ENABLE) competes with the gates
# above; P4 4A reconciles/deprecates it so the composition slot has a single gate.
# EXECUTION_ENABLE=1

# IBKR observational market data (ADR-LIVE-002). All default off; read-only.
# Requires the local Client Portal Gateway (https://127.0.0.1:5000/v1/api).
# IMP_IBKR_LIVE=1
# IMP_IBKR_TRANSPORT=client_portal       # set to tws for desktop IB Gateway
# IMP_IBKR_GATEWAY_URL=https://127.0.0.1:5000/v1/api   # loopback only; refused otherwise
# IMP_IBKR_TWS_HOST=127.0.0.1
# IMP_IBKR_TWS_PORT=4001                 # 4002 only for an explicitly configured paper Gateway
# IMP_IBKR_TWS_CLIENT_ID=37               # unique positive socket client ID
# IMP_IBKR_CAPTURE_ROOT=...                            # observational capture root override
# IMP_IBKR_PACING_RPS=10                               # global token bucket (IBKR documented ceiling)
# IMP_IBKR_HIST_MIN_SPACING_SEC=15                     # identical-query spacing for /hmds/history
# IMP_IBKR_HIST_WINDOW_MAX=50                          # rolling 10-min history cap (below IBKR's 60)
# IMP_IBKR_PENALTY_BOX_SEC=900                         # 429 penalty-box stop (IBKR: 15 minutes)
# Credentials live in .private/providers.env (IBKR_USERNAME, IBKR_PASSWORD,
# IBKR_TOTP_SECRET) — never commit, never log.

# Moomoo paper execution adapter (Platformization P4 / sub-milestone 4C). All default off.
# P4-4C, PAPER/SIMULATED-ENVIRONMENT ONLY: targets the separate Moomoo OpenAPI simulated
# trading environment through a local OpenD gateway — never a live brokerage account
# (LIVE-001 stays blocked). Fixture-first: recorded responses only; the real wire is the
# proprietary OpenD TCP/protobuf protocol with no official HTTP gateway, so no network
# transport is implemented under the stdlib-only lock. Mutually exclusive with the
# Tradier 4A gates above: one composition holds at most one paper execution provider.
# Never set any of these in CI.
# IMP_MOOMOO_PAPER=1                       # enable the Moomoo paper execution adapter
# IMP_MOOMOO_PAPER_EXECUTION=1             # BROKER_PAPER authority (mirrors IMP_BROKER_PAPER_EXECUTION)
# IMP_MOOMOO_PAPER_KEY=                    # OpenAPI key (never commit real values)
# IMP_MOOMOO_PAPER_SECRET=                 # OpenAPI secret (never commit real values)
# IMP_MOOMOO_PAPER_HOST=127.0.0.1          # local OpenD gateway host; loopback only, fails closed otherwise
# IMP_MOOMOO_PAPER_PORT=11111              # local OpenD gateway port
# IMP_MOOMOO_PAPER_TRADE_ENV=SIMULATE      # fails closed unless exactly SIMULATE
