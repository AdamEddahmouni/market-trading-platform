{
  "schema_version": "1.0",
  "policy": "route by task risk and reasoning depth, not vendor branding",
  "tiers": {
    "cheap": {
      "tasks": ["exploration", "inventory", "formatting", "mechanical edits", "simple test expansion"],
      "delegates": ["explore", "implementation"]
    },
    "normal": {
      "tasks": ["ordinary implementation", "focused debugging", "routine documentation", "routine testing"],
      "delegates": ["implementation", "testing", "debugging", "documentation-review"]
    },
    "high_reasoning": {
      "tasks": ["architecture", "Paper execution", "authority", "persistence", "security", "cross-cutting review", "closure"],
      "delegates": ["architecture", "safety-review", "frontend-review", "documentation-review"]
    }
  },
  "escalate_when": [
    "a change crosses an authority or persistence boundary",
    "Demo/Paper/Live behavior could differ",
    "source-time or account identity semantics could change",
    "validation evidence is contradictory or baseline attribution is unclear"
  ],
  "parallelism": {
    "allowed": ["independent discovery", "independent pure edits", "isolated PARALLEL_SAFE tests"],
    "forbidden": ["shared files", "authority", "execution", "persistence", "validation inventory", "final closure"]
  }
}
