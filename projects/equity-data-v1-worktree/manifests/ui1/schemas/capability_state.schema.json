{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui1.capability_state",
  "title": "CapabilityState",
  "type": "object",
  "required": ["capability_id", "state"],
  "properties": {
    "capability_id": { "type": "string" },
    "state": {
      "enum": ["AVAILABLE", "UNSUPPORTED", "NOT_ENTITLED", "NOT_COLLECTED", "LOADING", "DEGRADED"]
    },
    "reason": { "type": "string" },
    "explanation_ref": { "type": "string" }
  },
  "additionalProperties": false
}
