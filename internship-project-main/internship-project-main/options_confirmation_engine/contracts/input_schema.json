{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OptionsEngineInput",
  "type": "object",
  "required": ["request_id", "tickers"],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": ["string", "null"]
    },
    "tickers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overrides": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
