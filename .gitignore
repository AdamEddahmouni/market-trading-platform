# Nested Git repositories and agent worktrees remain independently versioned.
.worktrees/

# Local environments, dependencies, caches, and generated output.
**/.venv/
**/venv/
**/env/
**/node_modules/
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.vite/
**/*.tsbuildinfo
**/.local/
**/dist/
**/coverage/
**/*.pyc

# Local secrets and credentials.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credentials*
**/*secrets*

