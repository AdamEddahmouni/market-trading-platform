//@version=6
indicator("Custom Volume Bubble 1m/1s L1", overlay=true, max_labels_count=500)
import TradingView/ta/11 as volumeDeltaLib

var string dataSettingsGroup = "Data Settings"
var string quantLogicGroup = "Quant Logic"
var string absorptionGroup = "Absorption Logic (Effort vs Result)"
var string visualsGroup = "Visuals"
var string alertsGroup = "Alert Configuration"
var string alertInstructions = "Check the boxes below to enable internal alerts. When creating the Alert in TradingView, select 'Any alert() function call'."

calculationSource = input.string("Volume Delta", "Calculation Source", options=["Volume Delta", "Regular Volume"], group=dataSettingsGroup, tooltip="Switch between underlying Volume Delta or standard Total Volume for the Z-Score analysis.")
lowerTimeframe = input.timeframe("1S", "Lower TF Granularity", group=dataSettingsGroup, tooltip="Lower TF used for lower-timeframe VWAP calculation and Delta aggregation.")
anchorTimeframe = input.timeframe("", "Anchor TF (empty = current)", group=dataSettingsGroup)
lookbackPeriod = input.int(60, "Statistical Lookback", minval=20, group=dataSettingsGroup, tooltip="Bars used for Mean and StDev calculations.")

calculationMode = input.string("Adaptive (Z-Score)", "Calculation Mode", options=["Adaptive (Z-Score)", "Fixed (Absolute Value)"], group=quantLogicGroup)
zScoreThreshold = input.float(2.0, "Z-Score Threshold (σ)", minval=0.5, step=0.1, group=quantLogicGroup, tooltip="How many standard deviations to trigger a bubble. 2.0 is statistically significant (Top 5%).")
fixedVolumeThreshold = input.float(200.0, "Fixed Mode: Min Volume", minval=1.0, group=quantLogicGroup, tooltip="Minimum threshold for raw volume/delta value.")

enableAbsorption = input.bool(false, "Detect Absorption", group=absorptionGroup, tooltip="Highlights high volume bars with small price movement (Trapped Traders).")
absorptionBodyRatio = input.float(0.6, "Absorption Ratio", minval=0.1, maxval=1.0, step=0.1, group=absorptionGroup, tooltip="Candle body must be smaller than [Ratio] * Average Body.")

showBullish = input.bool(true, "Show Bullish", inline="disp", group=visualsGroup)
showBearish = input.bool(true, "Show Bearish", inline="disp", group=visualsGroup)
scaleBubbleByZScore = input.bool(true, "Scale Size by Z-Score", inline="scale", group=visualsGroup)
useAdaptiveColorIntensity = input.bool(true, "Adaptive Color Intensity", inline="scale", group=visualsGroup)

fixedOpacity = input.int(85, "Fixed Opacity (1-100)", minval=1, maxval=100, group=visualsGroup, active=not useAdaptiveColorIntensity, tooltip="Controls transparency of Bubble, Glow, and Text when Adaptive Intensity is disabled.")
showGlow = input.bool(true, "Glow Effect", inline="glow", group=visualsGroup)
fontStyle = input.string("Default", "Font", options=["Default", "Monospace"], inline="font", group=visualsGroup)
themeSelection = input.string("Dark Theme (Mint–Coral)", "Theme", options=["Dark Theme (Mint–Coral)", "Light Theme (Royal–Sunset)"], group=visualsGroup)

enableThresholdAlert = input.bool(false, "Alert: Unusual Threshold Trigger", group=alertsGroup, tooltip="Triggers when the Z-Score or Fixed Value threshold is crossed (Standard Logic).\n" + alertInstructions)
enableAbsorptionAlert = input.bool(false, "Alert: Absorption Detected", group=alertsGroup, tooltip="Triggers specifically when Absorption logic is met (High Vol / Small Candle).\n" + alertInstructions)

type ThemeColors
    color bullishColor
    color bearishColor
    color bullishGlowColor
    color bearishGlowColor
    color absorptionGlowColor 
    color textColor

var themeColors = switch themeSelection
    "Dark Theme (Mint–Coral)" => ThemeColors.new(color.new(#009664, 0), color.new(#b6003d, 0), color.new(#00d19d, 85), color.new(#ff3679, 85), color.new(#9d00ff, 30), color.white)
    => ThemeColors.new(color.new(color.rgb(0, 102, 255), 0), color.new(color.rgb(255, 128, 0), 0), color.new(color.rgb(102, 178, 255), 85), color.new(color.rgb(255, 179, 102), 85), color.new(#6a00ff, 40), color.rgb(0, 0, 0))

string standardTicker = ticker.standard(syminfo.tickerid)

[deltaOpen, deltaHigh, deltaLow, deltaClose] = request.security(standardTicker, timeframe.period, volumeDeltaLib.requestVolumeDelta(lowerTimeframe, anchorTimeframe))
float barVolume = request.security(standardTicker, timeframe.period, volume)
[barOpen, barHigh, barLow, barClose] = request.security(standardTicker, timeframe.period, [open, high, low, close])
float atrValue = request.security(standardTicker, timeframe.period, ta.atr(14))
[lowerTfCloses, lowerTfVolumes] = request.security_lower_tf(standardTicker, lowerTimeframe, [close, volume])

float signalValue = 0.0

if calculationSource == "Volume Delta"
    signalValue := deltaClose - deltaOpen
else
    signalValue := barClose >= barOpen ? barVolume : -barVolume

float absoluteSignalValue = math.abs(signalValue)

float signalMean = ta.sma(absoluteSignalValue, lookbackPeriod)
float signalStdDev = ta.stdev(absoluteSignalValue, lookbackPeriod)
float zScore = signalStdDev != 0 ? (absoluteSignalValue - signalMean) / signalStdDev : 0.0

bool thresholdTriggered = false
if calculationMode == "Adaptive (Z-Score)"
    thresholdTriggered := zScore >= zScoreThreshold
else
    thresholdTriggered := absoluteSignalValue >= fixedVolumeThreshold

float candleBodySize = math.abs(barClose - barOpen)
float averageCandleBodySize = ta.sma(candleBodySize, lookbackPeriod)
bool isAbsorption = enableAbsorption and thresholdTriggered and (candleBodySize < averageCandleBodySize * absorptionBodyRatio)

float bubblePrice = na

if thresholdTriggered
    float priceVolumeSum = 0.0
    float volumeSum = 0.0
    int lowerTfBarCount = array.size(lowerTfCloses)
    
    if lowerTfBarCount > 0
        for i = 0 to lowerTfBarCount - 1
            float lowerTfVolume = array.get(lowerTfVolumes, i)
            float lowerTfPrice = array.get(lowerTfCloses, i)
            if not na(lowerTfVolume) and not na(lowerTfPrice)
                priceVolumeSum += lowerTfPrice * lowerTfVolume
                volumeSum += lowerTfVolume
    
    float lowerTfVwap = volumeSum > 0 ? priceVolumeSum / volumeSum : na
    bubblePrice := na(lowerTfVwap) ? (barOpen + barHigh + barLow + barClose) / 4.0 : lowerTfVwap

formatLargeNumber(float value) =>
    float absoluteValue = math.abs(value)
    absoluteValue >= 1e9 ? str.tostring(absoluteValue / 1e9, format.volume) + "B" : absoluteValue >= 1e6 ? str.tostring(absoluteValue / 1e6, format.volume) + "M" : absoluteValue >= 1e3 ? str.tostring(absoluteValue / 1e3, format.volume) + "K" : str.tostring(absoluteValue, format.volume)

if thresholdTriggered
    bool isBullish = signalValue > 0
    
    if (isBullish and showBullish) or (not isBullish and showBearish)
        
        float baseTransparency = 100.0 - fixedOpacity
        float bubbleTransparency = useAdaptiveColorIntensity ? math.max(0, 100 - (zScore * 20)) : baseTransparency
        color bubbleColor = isBullish ? color.new(themeColors.bullishColor, bubbleTransparency) : color.new(themeColors.bearishColor, bubbleTransparency)
        
        color selectedGlowColor = isAbsorption ? themeColors.absorptionGlowColor : (isBullish ? themeColors.bullishGlowColor : themeColors.bearishGlowColor)
        color glowColor = useAdaptiveColorIntensity ? selectedGlowColor : color.new(selectedGlowColor, baseTransparency)
        color labelTextColor = useAdaptiveColorIntensity ? themeColors.textColor : themeColors.textColor

        string bubbleSizeCategory = "S"
        if calculationMode == "Adaptive (Z-Score)" and scaleBubbleByZScore
            bubbleSizeCategory := zScore > zScoreThreshold + 2.0 ? "L" : zScore > zScoreThreshold + 1.0 ? "M" : "S"
        else if scaleBubbleByZScore
            bubbleSizeCategory := absoluteSignalValue > (fixedVolumeThreshold * 6) ? "L" : absoluteSignalValue > (fixedVolumeThreshold * 4) ? "M" : "S"
            
        string bubbleSize = switch bubbleSizeCategory
            "L" => size.large
            "M" => size.normal
            => size.small
        
        string glowSize = switch bubbleSize
            size.small  => size.normal
            size.normal => size.large
            => size.huge

        float dominanceDenominator = calculationSource == "Volume Delta" ? barVolume : absoluteSignalValue
        float dominanceRatio = dominanceDenominator != 0 ? absoluteSignalValue / dominanceDenominator : na
        
        string absorptionTooltipText = isAbsorption ? "\n⚠️ ABSORPTION DETECTED ⚠️\n(High Vol / Low Move)" : ""
        string valueLabel = calculationSource == "Volume Delta" ? "Delta Vol: " : "Total Vol: "
        string directionLabel  = isBullish ? "Bullish " : "Bearish "
        string valueSign = calculationSource == "Volume Delta" ? (isBullish ? "+" : "-") : "" 
        
        string tooltipText = directionLabel + (calculationSource == "Volume Delta" ? "Delta" : "Vol") + absorptionTooltipText + "\n" + valueLabel + valueSign + formatLargeNumber(signalValue) + "\n" + "Z-Score: " + str.tostring(zScore, "#.##") + "σ\n" + (calculationSource == "Volume Delta" ? "Dom: " + str.tostring(dominanceRatio * 100, format.mintick) + "%" : "")

        if showGlow
            label.new(bar_index, bubblePrice, "", xloc.bar_index, yloc.price, color=glowColor, style=label.style_circle, size=glowSize, tooltip=tooltipText)
            
        label.new(bar_index, bubblePrice, "", xloc.bar_index, yloc.price, color=bubbleColor, style=label.style_circle, size=bubbleSize, tooltip=tooltipText)
                  
        string displaySign = ""
        
        if calculationSource == "Volume Delta"
            displaySign := isBullish ? "+" : "-"
        else
            displaySign := ""
            
        string bubbleText = displaySign + formatLargeNumber(signalValue)

        label.new(bar_index, bubblePrice, bubbleText, xloc.bar_index, yloc.price, color=color.new(color.white, 100), style=label.style_label_center, textalign=text.align_center, textcolor=labelTextColor, size=bubbleSize, text_font_family=fontStyle == "Monospace" ? font.family_monospace : font.family_default, tooltip=tooltipText)

if barstate.isconfirmed and thresholdTriggered
    string alertMessage = ""
    bool shouldSendAlert = false
    
    string alertMode = calculationSource == "Volume Delta" ? "Delta" : "Volume"
    string formattedAlertValue  = formatLargeNumber(signalValue)
    string formattedZScore    = str.tostring(zScore, "#.##")

    if isAbsorption and enableAbsorptionAlert
        alertMessage := "⚠️ ABSORPTION DETECTED on " + syminfo.ticker + "\n" + "Mode: " + alertMode + "\n" + "Value: " + formattedAlertValue + "\n" + "Price: " + str.tostring(barClose, format.mintick)
        shouldSendAlert := true
    
    else if enableThresholdAlert
        alertMessage := "🚨 UNUSUAL " + alertMode + " on " + syminfo.ticker + "\n" + "Value: " + formattedAlertValue + "\n" + "Z-Score: " + formattedZScore + "σ"
        shouldSendAlert := true

    if shouldSendAlert
        alert(alertMessage, alert.freq_once_per_bar_close)