# Assistant inference (optional — copy to your shell or a local .env file; never commit secrets)
ANTHROPIC_API_KEY=CHANGEME
ANTHROPIC_MODEL=claude-sonnet-4-20250514
IMP_ASSISTANT_PROVIDER=anthropic

# Fallback modes:
# IMP_ASSISTANT_PROVIDER=grounded
# IMP_ASSISTANT_STUB=1

# Public SEC EDGAR (no API key). Required for live/opt-in SEC access.
# Example: IntegratedMarketPlatform research contact@example.com
SEC_USER_AGENT=
# IMP_EDGAR_LIVE=1
# SEC_LIVE_TESTS=1

# FINRA Individual Public API credential (never commit real values).
# Runtime OAuth uses Client ID + Client Secret only. Gateway login is not used.
FINRA_CLIENT_ID=
FINRA_CLIENT_SECRET=
# Non-secret rotation metadata (ISO date). Do not infer expiry from the secret.
FINRA_SECRET_ROTATED_AT=
# Optional explicit expiry. If unset, rotated_at + 365 days is used when rotated_at is set.
FINRA_SECRET_EXPIRES_AT=
# IMP_FINRA_LIVE=1
# IMP_NASDAQ_REGSHO_LIVE=1
# IMP_NYSE_REGSHO_LIVE=1
# IMP_FINRA_OTC_THRESHOLD_LIVE=1
# IMP_CBOE_REGSHO_LIVE=1
# IMP_SEC_FTD_LIVE=1

# Federal Reserve Bank of St. Louis FRED / ALFRED (never commit real values).
FRED_API_KEY=
# IMP_FRED_LIVE=1

# U.S. Energy Information Administration Open Data API v2 (never commit real values).
EIA_API_KEY=
# IMP_EIA_LIVE=1

# NOAA/NWS/CPC weather evidence requires no API credential.
# Optional non-secret NWS application identifier override:
# IMP_NWS_USER_AGENT=integrated-market-platform-weather/1.0
# Opt-in live weather validation:
# IMP_WEATHER_LIVE=1

# Live observational market data (Platformization P2/P2.1). All default off.
# IMP_LIVE_OBSERVATIONAL=1
# IMP_MOOMOO_LIVE=1
# IMP_MOOMOO_HOST=127.0.0.1
# IMP_MOOMOO_PORT=11111
# IMP_PAPER_EXECUTION=1
# IMP_LIVE_INTERNAL_SIMULATION=1
# Optional local JSONL feed for offline/CI live-runtime testing (no OpenD needed).
# IMP_LIVE_FIXTURE_FEED=...
# IMP_LIVE_CAPTURE_ROOT=...                 # capture root override
# IMP_MOOMOO_SUBSCRIPTION_QUOTA=...         # max concurrent subscriptions
# IMP_LIVE_EXECUTION_WAIT_MS=8000           # wait for an EXECUTION_ADMITTED event
# IMP_LIVE_EXECUTION_FRESHNESS_MS=5000      # max fresh L1 age for execution
# IMP_LIVE_QUOTE_STALE_MS=5000              # quote staleness threshold
# IMP_LIVE_CLOCK_DRIFT_MS=60000             # provider clock drift tolerance
# IMP_LIVE_RECONNECT_BACKOFF_SEC=1,2,5,10,30

# Finviz Elite export API (never commit real values).
# Official export token from https://elite.finviz.com/ — also accepts FINVIZ_AUTH_TOKEN.
FINVIZ_API_KEY=
# IMP_FINVIZ_LIVE=1
# IMP_FINVIZ_CAPTURE_DIR=...                # prospective capture root
# IMP_FINVIZ_EVIDENCE_DIR=...               # evidence output override
# IMP_FINVIZ_SECRET_DIR=.private            # token/login file store
# Optional provider credential file (FINVIZ_API_KEY, etc.)
# IMP_PROVIDER_ENV=.private/providers.env

# Local durable state (P3). Override directory; never commit the DB.
# IMP_PERSIST_STATE=1
# IMP_STATE_DIR=
